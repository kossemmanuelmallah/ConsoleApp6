<Window x:Class="TaskManager1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManager1.ViewModels"
        xmlns:conv="clr-namespace:TaskManager1.Converters"
        Title="Менеджер задач — ЛР №6 (прототип)"
        Height="950" Width="1400"
        FontFamily="Times New Roman"
        FontSize="28"
        WindowStartupLocation="CenterScreen">

    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:1.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ═══════════ STYLES & PINCEAUX (Lab 5 + Lab 6) ═══════════ -->
        <SolidColorBrush x:Key="BrushFondPanneau" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="BrushBordure"     Color="#888888"/>
        <SolidColorBrush x:Key="BrushPrimaire"    Color="#4A90D9"/>
        <SolidColorBrush x:Key="BrushDanger"      Color="#D9534F"/>
        <SolidColorBrush x:Key="BrushSucces"      Color="#5CB85C"/>
        <SolidColorBrush x:Key="BrushTexteBlanc"  Color="White"/>
        <SolidColorBrush x:Key="BrushTexteGris"   Color="#555555"/>
        <SolidColorBrush x:Key="BrushTexteClair"  Color="#888888"/>

        <LinearGradientBrush x:Key="BrushEnteteDegrade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A90D9" Offset="0.0"/>
            <GradientStop Color="#357ABD" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrushFondDegrade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F0F4F8" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="BrushIconeDegrade">
            <GradientStop Color="#FFD700" Offset="0.0"/>
            <GradientStop Color="#FFA500" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Converters instanciés ICI (le prototype les utilise partout) -->
        <conv:PriorityToBrushConverter x:Key="PriorityToBrush"/>
        <conv:BoolToStatusConverter    x:Key="BoolToStatus"/>

        <!-- Storyboards (prototype animé) -->
        <Storyboard x:Key="PulsationStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:1" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="RotationStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:4"/>
        </Storyboard>

        
        <Style x:Key="TitreStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexteBlanc}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

       
        <Style x:Key="BoutonAnime" TargetType="Button">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexteBlanc}"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimaire}"/>
            <Setter Property="Padding"    Value="10,5"/>
            <Setter Property="MinWidth"   Value="150"/>
            <Setter Property="MinHeight"  Value="45"/>
            <Setter Property="Margin"     Value="0,0,5,5"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#2E6DA4" BorderThickness="2" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5DA0E0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.08" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.08" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource BoutonAnime}">
            <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
        </Style>
        <Style x:Key="BoutonSucces" TargetType="Button" BasedOn="{StaticResource BoutonAnime}">
            <Setter Property="Background" Value="{StaticResource BrushSucces}"/>
        </Style>

        <Style x:Key="ChampTexte" TargetType="TextBox">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="Height"     Value="50"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
            <Setter Property="Padding"    Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        
        <Style x:Key="ChampTexteValide" TargetType="TextBox" BasedOn="{StaticResource ChampTexte}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin"   Value="0,0,0,10"/>
            <Setter Property="Padding"  Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BorderArrondi" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background"   Value="{StaticResource BrushFondPanneau}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BrushBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="5"/>
            <Setter Property="Margin"       Value="5"/>
        </Style>

    </Window.Resources>

    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BrushFondDegrade}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Menu Grid.Row="0" FontSize="28">
            <MenuItem Header="Файл">
                <MenuItem Header="Создать задачу" Command="{Binding AddTaskCommand}"/>
                <MenuItem Header="Удалить задачу" Command="{Binding DeleteTaskCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Сохранить" Command="{Binding SaveTaskCommand}"/>
                <MenuItem Header="Отмена" Command="{Binding CancelCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

      
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Style="{StaticResource BoutonAnime}" Command="{Binding AddTaskCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="20" Height="20" Fill="{StaticResource BrushTexteBlanc}" Margin="0,0,8,0"/>
                        <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BoutonDanger}" Command="{Binding DeleteTaskCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="20" Height="20" Fill="{StaticResource BrushTexteBlanc}" Margin="0,0,8,0"/>
                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Style="{StaticResource BoutonSucces}" Command="{Binding SaveTaskCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="20" Height="20" Fill="{StaticResource BrushTexteBlanc}" Margin="0,0,8,0"/>
                        <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

           
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0" Background="{StaticResource BrushEnteteDegrade}"
                        CornerRadius="10" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="40" Height="40"
                                 Fill="{StaticResource BrushIconeDegrade}"
                                 Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource RotationStoryboard}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="📋 Мои задачи" Style="{StaticResource TitreStyle}"/>
                            <Line X1="0" Y1="0" X2="200" Y2="0"
                                  Stroke="{StaticResource BrushTexteBlanc}" StrokeThickness="2"
                                  Margin="0,5,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FONCTIONNALITÉ : Recherche + Filtre (prototype interactif) -->
                <GroupBox Grid.Row="1" Header="Поиск и фильтр"
                          Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="220" Height="45" Style="{StaticResource ChampTexte}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Приоритет:" Margin="15,0,8,0"
                                   VerticalAlignment="Center" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Width="160" Height="45" FontSize="28"
                                  SelectedIndex="{Binding FilterPriorityIndex}">
                            <ComboBoxItem Content="Все" IsSelected="True"/>
                            <ComboBoxItem Content="Низкий"/>
                            <ComboBoxItem Content="Обычный"/>
                            <ComboBoxItem Content="Высокий"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                
                <GroupBox Grid.Row="2" Header="Список задач"
                          Style="{StaticResource GroupBoxStyle}">
                    <ListBox FontSize="28" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding TasksView}"
                             SelectedItem="{Binding SelectedTask}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BorderArrondi}" Margin="3" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="20" Height="20"
                                                 Fill="{Binding PriorityIndex,
                                                        Converter={StaticResource PriorityToBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="20"
                                                       Foreground="{StaticResource BrushTexteGris}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Tags}" FontSize="18"
                                                       Foreground="{StaticResource BrushTexteClair}"
                                                       FontStyle="Italic" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsDone,
                                                              Converter={StaticResource BoolToStatus}}"
                                                       FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="✔"
                                                    Style="{StaticResource BoutonSucces}"
                                                    MinWidth="50" MinHeight="40"
                                                    Command="{Binding DataContext.ToggleDoneCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <WrapPanel Grid.Row="3">
                    <Button Content="Добавить" Style="{StaticResource BoutonAnime}"
                            Margin="0,0,10,0" Command="{Binding AddTaskCommand}"/>
                    <Button Content="Удалить" Style="{StaticResource BoutonDanger}"
                            Command="{Binding DeleteTaskCommand}"/>
                </WrapPanel>
            </Grid>

           
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

               
                <GroupBox Grid.Row="0" Header="Основное" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="Название:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource ChampTexteValide}"
                                 Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"/>
                        <TextBlock Text="Теги (через запятую):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="36" Height="36" Margin="0,0,12,0">
                                <Path Fill="{StaticResource BrushIconeDegrade}"
                                      Data="M 12,2 L 15,9 L 22,9 L 16.5,13.5 L 18.5,21 L 12,16.5 L 5.5,21 L 7.5,13.5 L 2,9 L 9,9 Z">
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Path.Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource PulsationStoryboard}"/>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Viewbox>
                            <TextBlock Text="Приоритет:" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="280" Height="45" FontSize="28"
                                      SelectedIndex="{Binding PriorityIndex}">
                                <ComboBoxItem Content="Низкий"/>
                                <ComboBoxItem Content="Обычный"/>
                                <ComboBoxItem Content="Высокий"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                
                <GroupBox Grid.Row="1" Header="Описание" Style="{StaticResource GroupBoxStyle}">
                    <TextBox Height="180" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="28" Padding="8"
                             BorderBrush="{StaticResource BrushBordure}" BorderThickness="1"
                             Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"/>
                </GroupBox>

                <Expander Grid.Row="2" Header="Дополнительно"
                          Margin="0,0,0,10" IsExpanded="False" FontSize="28">
                    <Border Style="{StaticResource BorderArrondi}">
                        <StackPanel>
                            <TextBlock Text="Версия: 2.0 (ЛР №6 — прототип)"/>
                            <TextBlock Text="Mode : MVVM + Validation + Filtres + JSON"/>
                        </StackPanel>
                    </Border>
                </Expander>

               
                <GroupBox Grid.Row="3" Header="Быстрые действия" Style="{StaticResource GroupBoxStyle}">
                    <Canvas Height="150" Background="{StaticResource BrushFondDegrade}">
                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="50" Height="50"
                                 Fill="{StaticResource BrushSucces}"/>
                        <Button Canvas.Left="70" Canvas.Top="15"
                                Content="✔ Готово" Width="150" Height="40" FontSize="28"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="75" Width="50" Height="50"
                                   Fill="{StaticResource BrushPrimaire}" RadiusX="8" RadiusY="8"/>
                        <Button Canvas.Left="70" Canvas.Top="80"
                                Content="⏰ Отложить" Width="150" Height="40" FontSize="28"/>
                        <Line X1="240" Y1="15" X2="240" Y2="125"
                              Stroke="{StaticResource BrushBordure}" StrokeThickness="2"/>
                        <Button x:Name="BtnGlisse" Canvas.Left="260" Canvas.Top="15"
                                Content="📌 В избранное" Width="150" Height="40" FontSize="28">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)"
                                                             From="260" To="290" Duration="0:0:2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Canvas.Left="260" Canvas.Top="80"
                                Content="📤 Экспорт" Width="150" Height="40" FontSize="28"/>
                    </Canvas>
                </GroupBox>

                
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="💾 Сохранить" Style="{StaticResource BoutonSucces}"
                            MinWidth="190" MinHeight="55" Margin="0,0,15,0"
                            Command="{Binding SaveTaskCommand}"/>
                    <Button Content="↩ Отмена" Style="{StaticResource BoutonDanger}"
                            MinWidth="190" MinHeight="55"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        
        <StatusBar Grid.Row="3" FontSize="28">
            <StatusBar.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F0F4F8" Offset="0.0"/>
                    <GradientStop Color="#D8E2EC" Offset="1.0"/>
                </LinearGradientBrush>
            </StatusBar.Background>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TaskCount, StringFormat='Всего: {0}'}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding DoneCount, StringFormat='✔ {0}'}" Margin="0,0,20,0"
                               Foreground="{StaticResource BrushSucces}"/>
                    <TextBlock Text="{Binding PendingCount, StringFormat='⏳ {0}'}"
                               Foreground="{StaticResource BrushPrimaire}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>